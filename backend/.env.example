# Copy this file to .env and fill in your values.
# NEVER commit the real .env file — add it to .gitignore.

# Google Fact Check Tools API key
# Get yours at: https://developers.google.com/fact-check/tools/api/
GOOGLE_FACT_CHECK_API_KEY=your_google_fact_check_api_key_here

# YouTube Data API v3 key (used to fetch channel name for credibility checks)
# Get yours at: https://console.cloud.google.com → APIs & Services → YouTube Data API v3
YOUTUBE_DATA_API_KEY=your_youtube_data_api_key_here

# CORS origin for your deployed frontend (tighten before submission)
# Example: https://my-fake-news-detector.vercel.app
ALLOWED_ORIGIN=http://localhost:3000
